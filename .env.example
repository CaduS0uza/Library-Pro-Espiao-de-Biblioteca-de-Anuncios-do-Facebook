# Copie para .env e preencha (NUNCA comite o .env real)

# Apify — token do actor apify/facebook-ads-scraper
APIFY_TOKEN=

# Supabase (backend). Sem isso, cai no fallback Netlify Blobs.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
# Opcional: pool inicial de tokens Apify (JSON) pra contingência
APIFY_TOKENS=

# Cripto das senhas (AES-256-GCM). Gere uma forte: openssl rand -hex 32
ENC_KEY=

# Admin único da plataforma
ADMIN_EMAIL=
ADMIN_PASS=

# E-mail de recuperação de senha (Resend)
RESEND_API_KEY=
MAIL_FROM=LibPro <onboarding@resend.dev>
